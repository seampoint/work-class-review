nous"}},{"name":"vitals_age_seconds","value":{"type_ref":"t.seconds","value":"120"}}],"instance":"sepsis-instance-1","interface":"order-entry","occurrence":"sha256:c96b0da71abc92979fc553bd75a0d21d62f1f6fbeec4a617a83af7f487401f77","operation":"place-antibiotic-order","schema":"seampoint.work-class/1.0.0-draft.2/authority-proposal","step":"order-antibiotic","work_class":"sepsis-surveillance-bundle","work_class_digest":"sha256:14e2f611639dd4dd1cc525516eea29f45c102779bcfce20a4287537cff87141e"},"returns":[{"act_bytes_base64":"","act_digest":"sha256:6f56c82eeb2f963152f840bac7514fe1bc9b2b2edab43ad73bcf61f3c1eed3bd","actor":"pharmacist-1","channel":"authority-return-channel","evidence_ref":"return-attest-grant-antibiotic-order-authority-evidence","id":"return-attest-grant-antibiotic-order-authority","provider":"hospital-identity-provider","returned_at":"2026-09-01T09:01:00Z"},{"act_bytes_base64":"","act_digest":"sha256:c6a569a98df51605095385f529f370844843ef27a644d554f0a98cb3bf4dbea0","actor":"person-medical-director","channel":"authority-return-channel","evidence_ref":"return-grant-antibiotic-order-authority-evidence","id":"return-grant-antibiotic-order-authority","provider":"hospital-identity-provider","returned_at":"2026-09-01T09:00:00Z"},{"act_bytes_base64":"","act_digest":"sha256:599130727d15c183a9a61d0d09a172e3a7d485984409abcc918eed8a36315e00","actor":"attending-hospitalist-1","channel":"authority-return-channel","evidence_ref":"return-order-decision-c96b0da71abc-0834-a-evidence","id":"return-order-decision-c96b0da71abc-0834-a","provider":"hospital-identity-provider","returned_at":"2026-09-12T08:34:00Z"},{"act_bytes_base64":"","act_digest":"sha256:f2206f75b8a931cf78ba072ce1ebee89a8219661672520033da27511333176d6","actor":"pharmacist-1","channel":"authority-return-channel","evidence_ref":"return-verify-order-decision-c96b0da71abc-0834-a-evidence","id":"return-verify-order-decision-c96b0da71abc-0834-a","provider":"hospital-identity-provider","returned_at":"2026-09-12T08:35:00Z"}],"schema":"seampoint.work-class/1.0.0-draft.2/authority-input","source":{"id":"sepsis-surveillance-policy","obligations":[{"id":"alert-window-cap","text":"A patient receives at most two sepsis alerts in any rolling six-hour window; a further alert inside the window is refused by the alert-count aggregate and recorded as suppressed before any instance is deployed."},{"id":"antibiotic-requires-physician-order","text":"An antibiotic order requires the attending physician's per-instance order naming the patient, drug, dose and route, verified by pharmacy; the surveillance agent's proposal is a candidate and the physician's order is the act."},{"id":"bundle-completion-is-reconciled","text":"The bundle completes only on native records: the laboratory result record and the medication administration record. An order with no administration record is an unknown outcome that neither completes nor releases the obligation, and a result that arrives after its deadline counts as evidence for what it shows without making the missed deadline met."},{"id":"cultures-before-antibiotics-unless-overridden","text":"Blood cultures are drawn before antibiotics are administered unless drawing them would delay antibiotics more than forty-five minutes, in which case the attending may authorize administration first and the reason is recorded with the order."},{"id":"escalate-unacknowledged-page","text":"The attending is paged on alert; if no acknowledgement is recorded within fifteen minutes of the page, the agent escalates to the rapid-response team and the bundle continues."},{"id":"hour-one-bundle","text":"Time zero is the alert's recorded recognition time. Screening labs are resulted and antibiotics administered, each with native evidence, within one hour of time zero."},{"id":"screening-under-standing-protocol","text":"A registered nurse may order the sepsis screening set (lactate, blood cultures, complete blood count) under the standing protocol without a physician order; the grant is limited to the named tests, bound to the protocol version, and withdrawn when the version is retired."},{"id":"vitals-freshness","text":"Vitals older than fifteen minutes are indeterminate for any decision that depends on them; an indeterminate observation holds the dependent action and a fresh observation re-evaluates it."}],"revision":"v3","schema":"seampoint.work-class/1.0.0-draft.2/authority-source"},"specification_pin":"sha256:dc925a1473d788e69f8912136e84796b143bc60dfe118ae004ba310a0108f1ea","work_class":{"id":"sepsis-surveillance-bundle","revision":"r1","schema":"seampoint.work-class/1.0.0-draft.2/authority-work-class","steps":[{"executor_role":"surveillance-agent","fields":[{"name":"assessment_id","type_ref":"t.identity"},{"name":"lookback_seconds","type_ref":"t.seconds"},{"name":"patient_id","type_ref":"t.identity"}],"id":"assess-readiness","interface":"monitoring-feed","operation":"assess-antibiotic-readiness","required_credentials":["surveillance-agent-credential"],"scope_fields":{"resources":["assessment_id"],"subjects":["patient_id"]}},{"executor_role":"surveillance-agent","fields":[{"name":"attempt_number","type_ref":"t.count"},{"name":"page_id","type_ref":"t.identity"},{"name":"patient_id","type_ref":"t.identity"}],"id":"escalate-rapid-response","interface":"paging-system","operation":"page-rapid-response","required_credentials":["surveillance-agent-credential"],"scope_fields":{"resources":["page_id"],"subjects":["patient_id"]}},{"executor_role":"attending-physician","fields":[{"name":"cultures_drawn_first","type_ref":"t.boolean"},{"name":"dose_mg","type_ref":"t.dose"},{"name":"drug","type_ref":"t.text"},{"name":"order_id","type_ref":"t.identity"},{"name":"override_reason","type_ref":"t.text"},{"name":"patient_id","type_ref":"t.identity"},{"name":"route","type_ref":"t.text"},{"name":"vitals_age_seconds","type_ref":"t.seconds"}],"id":"order-antibiotic","interface":"order-entry","operation":"place-antibiotic-order","required_credentials":["physician-licence"],"scope_fields":{"resources":["order_id"],"subjects":["patient_id"]}},{"executor_role":"registered-nurse","fields":[{"name":"order_set_id","type_ref":"t.identity"},{"name":"panel","type_ref":"t.text"},{"name":"patient_id","type_ref":"t.identity"},{"name":"test_count","type_ref":"t.count"}],"id":"order-screening-labs","interface":"order-entry","operation":"order-screening-set","required_credentials":["registered-nurse-licence"],"scope_fields":{"resources":["order_set_id"],"subjects":["patient_id"]}},{"executor_role":"surveillance-agent","fields":[{"name":"attempt_number","type_ref":"t.count"},{"name":"page_id","type_ref":"t.identity"},{"name":"patient_id","type_ref":"t.identity"}],"id":"page-attending","interface":"paging-system","operation":"page-attending-physician","required_credentials":["surveillance-agent-credential"],"scope_fields":{"resources":["page_id"],"subjects":["patient_id"]}},{"executor_role":"surveillance-agent","fields":[{"name":"alert_id","type_ref":"t.identity"},{"name":"patient_id","type_ref":"t.identity"},{"name":"risk_score","type_ref":"t.score"}],"id":"raise-alert","interface":"nurse-notification","operation":"raise-sepsis-alert","required_credentials":["surveillance-agent-credential"],"scope_fields":{"resources":["alert_id"],"subjects":["patient_id"]}},{"executor_role":"surveillance-agent","fields":[{"name":"attempt_number","type_ref":"t.count"},{"name":"patient_id","type_ref":"t.identity"},{"name":"refresh_id","type_ref":"t.identity"}],"id":"refresh-vitals","interface":"monitoring-feed","operation":"request-vitals-refresh","required_credentials":["surveillance-agent-credential"],"scope_fields":{"resources":["refresh_id"],"subjects":["patient_id"]}}],"types":[{"id":"t.boolean","kind":"BOOLEAN","nonnegative":false,"unit":null},{"id":"t.count","kind":"INTEGER","nonnegative":true,"unit":null},{"id":"t.dose","kind":"DECIMAL","nonnegative":true,"unit":"mg"},{"id":"t.identity","kind":"IDENTITY","nonnegative":false,"unit":null},{"id":"t.sco