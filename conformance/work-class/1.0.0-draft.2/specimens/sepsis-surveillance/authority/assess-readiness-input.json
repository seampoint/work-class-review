n-rev-9","revoked":false,"status":"AVAILABLE"}],"occupancies":[{"actor":"person-medical-director","evidence_ref":"occupancy-medical-director-evidence","id":"occupancy-medical-director","kind":"HUMAN","principal":"sample-hospital","provider":"hospital-identity-provider","role":"medical-director","validity":{"valid_from":"2026-09-01T00:00:00Z","valid_until":"2026-12-01T00:00:00Z"}},{"actor":"person-quality-officer","evidence_ref":"occupancy-quality-officer-evidence","id":"occupancy-quality-officer","kind":"HUMAN","principal":"sample-hospital","provider":"hospital-identity-provider","role":"clinical-governance-attester","validity":{"valid_from":"2026-09-01T00:00:00Z","valid_until":"2026-12-01T00:00:00Z"}},{"actor":"sepsis-surveillance-agent","evidence_ref":"occupancy-surveillance-agent-evidence","id":"occupancy-surveillance-agent","kind":"MACHINE","principal":"sample-hospital","provider":"hospital-identity-provider","role":"surveillance-agent","validity":{"valid_from":"2026-09-01T00:00:00Z","valid_until":"2026-12-01T00:00:00Z"}}],"proposal":{"executor":{"actor":"sepsis-surveillance-agent","occupancy":"occupancy-surveillance-agent","principal":"sample-hospital","role":"surveillance-agent"},"fields":[{"name":"assessment_id","value":{"type_ref":"t.identity","value":"assessment-5501"}},{"name":"lookback_seconds","value":{"type_ref":"t.seconds","value":"600"}},{"name":"patient_id","value":{"type_ref":"t.identity","value":"patient-1"}}],"instance":"sepsis-instance-1","interface":"monitoring-feed","occurrence":"sha256:7dfe22ce5b950aa4e843b5df19b71939084d5b2dc47473fe00ff2b8119fd6a0c","operation":"assess-antibiotic-readiness","schema":"seampoint.work-class/1.0.0-draft.2/authority-proposal","step":"assess-readiness","work_class":"sepsis-surveillance-bundle","work_class_digest":"sha256:14e2f611639dd4dd1cc525516eea29f45c102779bcfce20a4287537cff87141e"},"returns":[{"act_bytes_base64":"","act_digest":"sha256:0bc637032e8f3acff309c99901bc98d3186a3a35b4c06b3a3f7281fd63b47933","actor":"person-quality-officer","channel":"authority-return-channel","evidence_ref":"return-attest-grant-assessment-authority-evidence","id":"return-attest-grant-assessment-authority","provider":"hospital-identity-provider","returned_at":"2026-09-01T09:01:00Z"},{"act_bytes_base64":"","act_digest":"sha256:cd70f10fea708b4870ca1bb528d3e286dffb5343e625e0a5450401ced3fb509f","actor":"person-medical-director","channel":"authority-return-channel","evidence_ref":"return-grant-assessment-authority-evidence","id":"return-grant-assessment-authority","provider":"hospital-identity-provider","returned_at":"2026-09-01T09:00:00Z"}],"schema":"seampoint.work-class/1.0.0-draft.2/authority-input","source":{"id":"sepsis-surveillance-policy","obligations":[{"id":"alert-window-cap","text":"A patient receives at most two sepsis alerts in any rolling six-hour window; a further alert inside the window is refused by the alert-count aggregate and recorded as suppressed before any instance is deployed."},{"id":"antibiotic-requires-physician-order","text":"An antibiotic order requires the attending physician's per-instance order naming the patient, drug, dose and route, verified by pharmacy; the surveillance agent's proposal is a candidate and the physician's order is the act."},{"id":"bundle-completion-is-reconciled","text":"The bundle completes only on native records: the laboratory result record and the medication administration record. An order with no administration record is an unknown outcome that neither completes nor releases the obligation, and a result that arrives after its deadline counts as evidence for what it shows without making the missed deadline met."},{"id":"cultures-before-antibiotics-unless-overridden","text":"Blood cultures are drawn before antibiotics are administered unless drawing them would delay antibiotics more than forty-five minutes, in which case the attending may authorize administration first and the reason is recorded with the order."},{"id":"escalate-unacknowledged-page","text":"The attending is paged on alert; if no acknowledgement is recorded within fifteen minutes of the page, the agent escalates to the rapid-response team and the bundle continues."},{"id":"hour-one-bundle","text":"Time zero is the alert's recorded recognition time. Screening labs are resulted and antibiotics administered, each with native evidence, within one hour of time zero."},{"id":"screening-under-standing-protocol","text":"A registered nurse may order the sepsis screening set (lactate, blood cultures, complete blood count) under the standing protocol without a physician order; the grant is limited to the named tests, bound to the protocol version, and withdrawn when the version is retired."},{"id":"vitals-freshness","text":"Vitals older than fifteen minutes are indeterminate for any decision that depends on them; an indeterminate observation holds the dependent action and a fresh observation re-evaluates it."}],"revision":"v3","schema":"seampoint.work-class/1.0.0-draft.2/authority-source"},"specification_pin":"sha256:dc925a1473d788e69f8912136e84796b143bc60dfe118ae004ba310a0108f1ea","work_class":{"id":"sepsis-surveillance-bundle","revision":"r1","schema":"seampoint.work-class/1.0.0-draft.2/authority-work-class","steps":[{"executor_role":"surveillance-agent","fields":[{"name":"assessment_id","type_ref":"t.identity"},{"name":"lookback_seconds","type_ref":"t.seconds"},{"name":"patient_id","type_ref":"t.identity"}],"id":"assess-readiness","interface":"monitoring-feed","operation":"assess-antibiotic-readiness","required_credentials":["surveillance-agent-credential"],"scope_fields":{"resources":["assessment_id"],"subjects":["patient_id"]}},{"executor_role":"surveillance-agent","fields":[{"name":"attempt_number","type_ref":"t.count"},{"name":"page_id","type_ref":"t.identity"},{"name":"patient_id","type_ref":"t.identity"}],"id":"escalate-rapid-response","interface":"paging-system","operation":"page-rapid-response","required_credentials":["surveillance-agent-credential"],"scope_fields":{"resources":["page_id"],"subjects":["patient_id"]}},{"executor_role":"attending-physician","fields":[{"name":"cultures_drawn_first","type_ref":"t.boolean"},{"name":"dose_mg","type_ref":"t.dose"},{"name":"drug","type_ref":"t.text"},{"name":"order_id","type_ref":"t.identity"},{"name":"override_reason","type_ref":"t.text"},{"name":"patient_id","type_ref":"t.identity"},{"name":"route","type_ref":"t.text"},{"name":"vitals_age_seconds","type_ref":"t.seconds"}],"id":"order-antibiotic","interface":"order-entry","operation":"place-antibiotic-order","required_credentials":["physician-licence"],"scope_fields":{"resources":["order_id"],"subjects":["patient_id"]}},{"executor_role":"registered-nurse","fields":[{"name":"order_set_id","type_ref":"t.identity"},{"name":"panel","type_ref":"t.text"},{"name":"patient_id","type_ref":"t.identity"},{"name":"test_count","type_ref":"t.count"}],"id":"order-screening-labs","interface":"order-entry","operation":"order-screening-set","required_credentials":["registered-nurse-licence"],"scope_fields":{"resources":["order_set_id"],"subjects":["patient_id"]}},{"executor_role":"surveillance-agent","fields":[{"name":"attempt_number","type_ref":"t.count"},{"name":"page_id","type_ref":"t.identity"},{"name":"patient_id","type_ref":"t.identity"}],"id":"page-attending","interface":"paging-system","operation":"page-attending-physician","required_credentials":["surveillance-agent-credential"],"scope_fields":{"resources":["page_id"],"subjects":["patient_id"]}},{"executor_role":"surveillance-agent","fields":[{"name":"alert_id","type_ref":"t.identity"},{"name":"patient_id","type_ref":"t.identity"},{"name":"risk_score","type_ref":"t.score"}],"id":"raise-alert","interface":"nurse-notification","operation":"raise-sepsis-alert","required_credentials":["surveillance-agent-credential"],"scope_fields":{"resources":["alert_id"],"subjects":["patient_id"]}},{"executor_role":"surveillance-agent","fields":[{"name":"attempt_number","type_ref":"t.count"},{"name":"patient_id","type_ref":"t.identity"},{"name":"refresh_id","type_ref":"t.identity"}],"id":"refresh-vitals","interface":"monitoring-feed","operation":"request-vitals-refresh","required_credentials":["surveillance-agent-credential"],"scope_fields":{"resources":["refresh_id"],"subjects":["patient_id"]}}],"types":[{"id":"t.boolean","kind":"BOOLEAN","nonnegative":false,"unit":null},{"id":"t.count","kind":"INTEGER","nonnegative":true,"unit":null},{"id":"t.dose","kind":"DECIMAL","nonnegative":true,"unit":"mg"},{"id":"t.identity","kind":"IDENTITY","nonnegative":false,"unit":null},{"id":"t.score","kind":"DECIMAL","nonnegative":true,"unit":null},{"id":"t.seconds","kind":"INTEGER","nonnegative":true,"unit":null},{"id":"t.text","kind":"STRING","nonnegative":false,"unit":null}]}}
