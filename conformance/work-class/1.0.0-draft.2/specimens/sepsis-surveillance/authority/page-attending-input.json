"person-medical-director","evidence_ref":"occupancy-medical-director-evidence","id":"occupancy-medical-director","kind":"HUMAN","principal":"sample-hospital","provider":"hospital-identity-provider","role":"medical-director","validity":{"valid_from":"2026-09-01T00:00:00Z","valid_until":"2026-12-01T00:00:00Z"}},{"actor":"person-quality-officer","evidence_ref":"occupancy-quality-officer-evidence","id":"occupancy-quality-officer","kind":"HUMAN","principal":"sample-hospital","provider":"hospital-identity-provider","role":"clinical-governance-attester","validity":{"valid_from":"2026-09-01T00:00:00Z","valid_until":"2026-12-01T00:00:00Z"}},{"actor":"sepsis-surveillance-agent","evidence_ref":"occupancy-surveillance-agent-evidence","id":"occupancy-surveillance-agent","kind":"MACHINE","principal":"sample-hospital","provider":"hospital-identity-provider","role":"surveillance-agent","validity":{"valid_from":"2026-09-01T00:00:00Z","valid_until":"2026-12-01T00:00:00Z"}}],"proposal":{"executor":{"actor":"sepsis-surveillance-agent","occupancy":"occupancy-surveillance-agent","principal":"sample-hospital","role":"surveillance-agent"},"fields":[{"name":"attempt_number","value":{"type_ref":"t.count","value":"1"}},{"name":"page_id","value":{"type_ref":"t.identity","value":"page-3301"}},{"name":"patient_id","value":{"type_ref":"t.identity","value":"patient-1"}}],"instance":"sepsis-instance-1","interface":"paging-system","occurrence":"sha256:0d3859836776bb13ef1b9bae8b79bc14c91def232cf2f19bc170259d5c8782f3","operation":"page-attending-physician","schema":"seampoint.work-class/1.0.0-draft.2/authority-proposal","step":"page-attending","work_class":"sepsis-surveillance-bundle","work_class_digest":"sha256:14e2f611639dd4dd1cc525516eea29f45c102779bcfce20a4287537cff87141e"},"returns":[{"act_bytes_base64":"","act_digest":"sha256:33052cd4e8c3cef8cd0f577a4e47ccad4ea0f4f4cb4643896acf990dd8bc719a","actor":"person-quality-officer","channel":"authority-return-channel","evidence_ref":"return-attest-grant-page-authority-evidence","id":"return-attest-grant-page-authority","provider":"hospital-identity-provider","returned_at":"2026-09-01T09:01:00Z"},{"act_bytes_base64":"","act_digest":"sha256:ee0a7212dee2db984bb28538bd4f19338a51539a4652093b5949628c9b8726f0","actor":"person-medical-director","channel":"authority-return-channel","evidence_ref":"return-grant-page-authority-evidence","id":"return-grant-page-authority","provider":"hospital-identity-provider","returned_at":"2026-09-01T09:00:00Z"}],"schema":"seampoint.work-class/1.0.0-draft.2/authority-input","source":{"id":"sepsis-surveillance-policy","obligations":[{"id":"alert-window-cap","text":"A patient receives at most two sepsis alerts in any rolling six-hour window; a further alert inside the window is refused by the alert-count aggregate and recorded as suppressed before any instance is deployed."},{"id":"antibiotic-requires-physician-order","text":"An antibiotic order requires the attending physician's per-instance order naming the patient, drug, dose and route, verified by pharmacy; the surveillance agent's proposal is a candidate and the physician's order is the act."},{"id":"bundle-completion-is-reconciled","text":"The bundle completes only on native records: the laboratory result record and the medication administration record. An order with no administration record is an unknown outcome that neither completes nor releases the obligation, and a result that arrives after its deadline counts as evidence for what it shows without making the missed deadline met."},{"id":"cultures-before-antibiotics-unless-overridden","text":"Blood cultures are drawn before antibiotics are administered unless drawing them would delay antibiotics more than forty-five minutes, in which case the attending may authorize administration first and the reason is recorded with the order."},{"id":"escalate-unacknowledged-page","text":"The attending is paged on alert; if no acknowledgement is recorded within fifteen minutes of the page, the agent escalates to the rapid-response team and the bundle continues."},{"id":"hour-one-bundle","text":"Time zero is the alert's recorded recognition time. Screening labs are resulted and antibiotics administered, each with native evidence, within one hour of time zero."},{"id":"screening-under-standing-protocol","text":"A registered nurse may order the sepsis screening set (lactate, blood cultures, complete blood count) under the standing protocol without a physician order; the grant is limited to the named tests, bound to the protocol version, and withdrawn when the version is retired."},{"id":"vitals-freshness","text":"Vitals older than fifteen minutes are indeterminate for any decision that depends on them; an indeterminate observation holds the dependent action and a fresh observation re-evaluates it."}],"revision":"v3","schema":"seampoint.work-class/1.0.0-draft.2/authority-source"},"specification_pin":"sha256:dc925a1473d788e69f8912136e84796b143bc60dfe118ae004ba310a0108f1ea","work_class":{"id":"sepsis-surveillance-bundle","revision":"r1","schema":"seampoint.work-class/1.0.0-draft.2/authority-work-class","steps":[{"executor_role":"surveillance-agent","fields":[{"name":"assessment_id","type_ref":"t.identity"},{"name":"lookback_seconds","type_ref":"t.seconds"},{"name":"patient_id","type_ref":"t.identity"}],"id":"assess-readiness","interface":"monitoring-feed","operation":"assess-antibiotic-readiness","required_credentials":["surveillance-agent-credential"],"scope_fields":{"resources":["assessment_id"],"subjects":["patient_id"]}},{"executor_role":"surveillance-agent","fields":[{"name":"attempt_number","type_ref":"t.count"},{"name":"page_id","type_ref":"t.identity"},{"name":"patient_id","type_ref":"t.identity"}],"id":"escalate-rapid-response","interface":"paging-system","operation":"page-rapid-response","required_credentials":["surveillance-agent-credential"],"scope_fields":{"resources":["page_id"],"subjects":["patient_id"]}},{"executor_role":"attending-physician","fie