{"core":{"budgets":[{"authorizations":[{"authority_definition":{"envelope":{"attester_role":"organizational-attester","bindings":[{"field":"track_id","id":"engage-track-track_id-binding","step":"engage-track","type_ref":"t.identity"}],"clock_source":"mission-clock","conditions":[{"id":"roe-classification-is-declared-threat","predicate":{"kind":"MEMBER","members":[{"type_ref":"t.label","value":"ARMED_ADULT"},{"type_ref":"t.label","value":"ARMED_QUADRUPED"}],"value":{"kind":"FIELD","name":"classification"}},"step":"engage-track"},{"id":"roe-confidence-at-or-above-bound","predicate":{"kind":"COMPARE","left":{"kind":"FIELD","name":"confidence"},"operator":"GTE","right":{"kind":"LITERAL","value":{"type_ref":"t.confidence","value":"0.9"}}},"step":"engage-track"},{"id":"roe-demonstrated-intent-present","predicate":{"kind":"MEMBER","members":[{"type_ref":"t.label","value":"AIMS_WEAPON_AT_FRIENDLY"},{"type_ref":"t.label","value":"DEMONSTRATES_IMMINENT_ATTACK"},{"type_ref":"t.label","value":"FIRES_AT_FRIENDLY"}],"value":{"kind":"FIELD","name":"demonstrated_intent"}},"step":"engage-track"},{"id":"roe-target-not-protected","predicate":{"kind":"EQUAL","left":{"kind":"FIELD","name":"protected_status"},"right":{"kind":"LITERAL","value":{"type_ref":"t.label","value":"NONE"}}},"step":"engage-track"}],"enforcement":{"mechanisms":["ATOMIC_SHARED_RESERVATION","AUTHORITY_BEFORE_RESERVATION"],"out_of_envelope":"REFUSE","safe_state":"NO_NEW_DISPATCH"},"escalation":{"authority_ref":"roe-engagement-authority","decision_required":"operator-direction-on-divergence","destination_role":"engagement-authority-operator","kind":"REQUIRED"},"executor_role":"fire-control-agent","gate":{"criteria":[{"id":"engage-track-operator-confirms-exact-proposal","predicate":{"kind":"BOOLEAN","value":true},"step":"engage-track"}],"kind":"DECIDE","materiality":"HIGH","reversibility":"NONE","role":"engagement-authority-operator"},"grant_ref":"engage-track-grant","grantor_role":"engagement-commander","id":"roe-engagement-authority","limitations":[],"limits":{"per_action":[],"shared_budgets":["engagements-per-window"]},"operations":[{"interface":"fire-control","operation":"engage-track","step":"engage-track"}],"principal":"sample-force-organization","revocation":{"max_age_seconds":"300","provider":"command-authority-provider","source":"roe-revocations"},"schema":"seampoint.work-class/1.0.0-draft.2/authority-envelope","scope":{"id":"engage-track-scope","resources":[{"kind":"CONSTANT","value":"mission-1"}],"subjects":[{"binding":"engage-track-track_id-binding","kind":"BINDING"}]},"source_digest":"sha256:f62bdb529b42a7ae5e91344cb6aade0fb42fc68ec091cbf52605bac0e4f73b5f","source_obligations":["roe-01-deadly-force-threat","roe-02-protected-status-bars-fire","roe-03-declared-threat-class-and-confidence","roe-04-rules-held-as-one-admitted-grant","roe-05-operator-decision-per-engagement","roe-06-direction-or-safe-state","roe-07-engagement-count-budget","roe-08-effect-established-only-by-assessment","roe-09-runtime-traceability"],"temporal_validity":{"valid_from":"2026-09-13T06:00:00Z","valid_until":"2026-09-14T06:00:00Z"},"work_class_digest":"sha256:bf01b44eb2e6c0f5ee950ad8d8a3cc098d7d74b17d1783de6f65c013da8308e7"},"schema":"seampoint.work-class/1.0.0-draft.2/authority-definition","source":{"id":"roe-engagement-rules","obligations":[{"id":"roe-01-deadly-force-threat","text":"Fire may be proposed against a track only when the observation record shows the track fires at, aims a weapon at, or otherwise demonstrates an intent to imminently attack the unit, friendly forces, or persons or property under designated protection. The declared intent values are AIMS_WEAPON_AT_FRIENDLY, FIRES_AT_FRIENDLY and DEMONSTRATES_IMMINENT_ATTACK; any other value withholds the proposal."},{"id":"roe-02-protected-status-bars-fire","text":"A track whose protected status is other than NONE is never a permitted subject."},{"id":"roe-03-declared-threat-class-and-confidence","text":"The nominated track carries a declared threat class (ARMED_ADULT or ARMED_QUADRUPED) with classification confidence at or above 0.9. A lower confidence or an undeclared class withholds the proposal until a fresh observation is proposed."},{"id":"roe-04-rules-held-as-one-admitted-grant","text":"The rules of engagement are one reusable grant issued by the engagement commander at an exact revision, valid for the mission window and withdrawable through the command revocation source. A withdrawn or expired grant withholds every later proposal and leaves committed engagements and their evidence in place."},{"id":"roe-05-operator-decision-per-engagement","text":"Every engagement requires an accepted per-instance decision by the engagement authority operator on the exact nominated track, organizationally attested. The resulting permit authorizes at most one dispatch of the exact request and expires 120 seconds after the proposal clock; after expiry a fresh proposal and a fresh operator decision are required."},{"id":"roe-06-direction-or-safe-state","text":"When a nomination diverges from these rules the proposal is withheld and the operator's direction is required. If no direction produces a permitted engagement within ten minutes of the occurrence's activation on the mission clock, the engagement occurrence stops and no dispatch may follow."},{"id":"roe-07-engagement-count-budget","text":"At most three engagements per mission may be committed or reserved within any rolling one-hour window on the mission clock, counted across every platform sharing the mission budget and including reserved engagements whose effect is not yet established."},{"id":"roe-08-effect-established-only-by-assessment","text":"An engagement completes only on attributable battle damage assessment evidence for the exact dispatched request. A dispatch acknowledgement is not an effect. An unavailable assessment keeps the engagement open and its reservation charged. An assessment naming another entity, or conflicting evidence, is retained as disputed and blocks further engagements on the affected budget partition."},{"id":"roe-09-runtime-traceability","text":"Every rule ingestion, proposal, permit, dispatch observation, effect observation and clock is retained as a record bound by digest to its predecessors, and every decision carries its reason codes so the record shows how the system decided."}],"revision":"r1","schema":"seampoint.work-class/1.0.0-draft.2/authority-source"},"work_class":{"id":"roe-engagement","revision":"r1","schema":"seampoint.work-class/1.0.0-draft.2/authority-work-class","steps":[{"executor_role":"fire-control-agent","fields":[{"name":"classification","type_ref":"t.label"},{"name":"confidence","type_ref":"t.confidence"},{"name":"demonstrated_intent","type_ref":"t.label"},{"name":"mission_id","type_ref":"t.identity"},{"name":"protected_status","type_ref":"t.label"},{"name":"track_id","type_ref":"t.identity"}],"id":"engage-track","interface":"fire-control","operation":"engage-track","required_credentials":["fire-control-credential"],"scope_fields":{"resources":["mission_id"],"subjects":["track_id"]}}],"types":[{"id":"t.confidence","kind":"DECIMAL","nonnegative":true,"unit":null},{"id":"t.identity","kind":"IDENTITY","nonnegative":false,"unit":null},{"id":"t.label","kind":"STRING","nonnegative":false,"unit":null}]}},"budget_digest":"sha256:30eded2719709c4dd91e5c5633182a7b48df43aaf44baa6e4bd90ebf032007cc","envelope_digest":"sha256:53ec3753fc2a65095bb85467547da9e87aa6292b1375e139a358bb7b388d8c62","id":"roe-engagement-budget-authorization","principal":"sample-force-organization","projection":[{"budget_field":"mission_id","budget_type":"b.identity","native_field":"mission_id","native_type":"t.identity"}],"step":"engage-track","work_class":"roe-engagement","work_class_digest":"sha256:bf01b44eb2e6c0f5ee950ad8d8a3cc098d7d74b17d1783de6f65c013da8308e7"}],"definition":{"aggregate":{"aggregate":{"bound":{"type_ref":"b.count","value":"3"},"committed_source":{"contribution":{"kind":"COUNT"},"