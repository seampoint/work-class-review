{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.seampoint.com/work-class/1.0.0-draft.2/protocol.schema.json",
  "$comment": "DRAFT_NOT_ADOPTED; APPARATUS_ONLY. The adapter uses this closed bundled schema graph.",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "profile": {
      "enum": [
        "LINEAR",
        "CHOICE_LOOPS",
        "DEADLINES",
        "PARALLEL_FANOUT"
      ]
    },
    "runtimeRole": {
      "enum": [
        "LINEAR_WORK_RUNTIME",
        "CHOICE_LOOP_RUNTIME",
        "DEADLINE_RUNTIME",
        "PARALLEL_FANOUT_RUNTIME"
      ]
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_definitions": {
          "const": "64"
        },
        "max_operations": {
          "const": "256"
        },
        "max_collection_members": {
          "const": "1024"
        },
        "max_numeric_digits": {
          "const": "128"
        },
        "max_expression_depth": {
          "const": "64"
        },
        "max_expression_nodes": {
          "const": "4096"
        }
      },
      "required": [
        "max_definitions",
        "max_operations",
        "max_collection_members",
        "max_numeric_digits",
        "max_expression_depth",
        "max_expression_nodes"
      ],
      "additionalProperties": false
    },
    "capabilitiesInput": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "capabilitiesResult": {
      "type": "object",
      "properties": {
        "status": {
          "const": "CAPABILITIES"
        },
        "protocol": {
          "const": "seampoint.work-class.adapter/1.0.0-draft.2"
        },
        "specification_pin": {
          "$ref": "#/$defs/digest"
        },
        "roles": {
          "type": "array",
          "items": {
            "enum": [
              "AGGREGATE_EVALUATOR",
              "AUTHORITY_EVALUATOR",
              "CHOICE_LOOP_RUNTIME",
              "DEADLINE_RUNTIME",
              "LINEAR_WORK_RUNTIME",
              "PARALLEL_FANOUT_RUNTIME",
              "REFERENCE_SINGLE_PROCESS_CONTENTION",
              "REVIEW_EVIDENCE",
              "SHARED_BUDGET_TRANSITIONS"
            ]
          },
          "minItems": 0,
          "maxItems": 9,
          "uniqueItems": true
        },
        "operations": {
          "type": "array",
          "items": {
            "enum": [
              "aggregate-step",
              "capabilities",
              "check-evidence",
              "deploy",
              "evaluate",
              "readback",
              "step",
              "validate"
            ]
          },
          "minItems": 0,
          "maxItems": 8,
          "uniqueItems": true
        },
        "tzdb": {
          "oneOf": [
            {
              "const": "2025a"
            },
            {
              "type": "null"
            }
          ]
        },
        "limits": {
          "$ref": "#/$defs/limits"
        }
      },
      "required": [
        "status",
        "protocol",
        "specification_pin",
        "roles",
        "operations",
        "tzdb",
        "limits"
      ],
      "additionalProperties": false
    },
    "evaluateInput": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "AGGREGATE"
            },
            "request": {
              "$ref": "https://schemas.seampoint.com/work-class/1.0.0-draft.2/aggregate.schema.json#/$defs/input"
            }
          },
          "required": [
            "kind",
            "request"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "AUTHORITY"
            },
            "request": {
              "$ref": "https://schemas.seampoint.com/work-class/1.0.0-draft.2/authority.schema.json#/$defs/input"
            }
          },
          "required": [
            "kind",
            "request"
          ],
          "additionalProperties": false
        }
      ]
    },
    "artifactInput": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "AGGREGATE_DEFINITION",
            "AUTHORITY_DEFINITION",
            "WORK_CLASS",
            "BOUNDARY_RECORD",
            "EVIDENCE_RECORD"
          ]
        },
        "specification_pin": {
          "$ref": "#/$defs/digest"
        },
        "artifact_bytes_base64": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "specification_pin",
        "artifact_bytes_base64"
      ],
      "additionalProperties": false
    },
    "validateResult": {
      "type": "object",
      "properties": {
        "status": {
          "const": "ACCEPTED"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "status",
        "digest"
      ],
      "additionalProperties": false
    },
    "readbackLine": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "value"
      ],
      "additionalProperties": false
    },
    "readbackResult": {
      "type": "object",
      "properties": {
        "status": {
          "const": "READBACK"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/readbackLine"
          },
          "minItems": 0
        }
      },
      "required": [
        "status",
        "digest",
        "lines"
      ],
      "additionalProperties": false
    },
    "shapeRefusal": {
      "type": "object",
      "properties": {
        "status": {
          "const": "REFUSED"
        },
        "code": {
          "enum": [
            "ADMINISTRATION_NOT_ESTABLISHED",
            "ARTIFACT_ENCODING_INVALID",
            "ARTIFACT_NONCANONICAL",
            "BINDING_MISMATCH",
            "CLOCK_INVALID",
            "DEFINITION_INVALID",
            "DEFINITION_CONFLICT",
            "DEPENDENCY_MISMATCH",
            "DIGEST_MISMATCH",
            "EVIDENCE_UNAVAILABLE",
            "INPUT_INVALID",
            "LIMIT_EXCEEDED",
            "INSTANCE_NOT_ACTIVE",
            "OCCURRENCE_NOT_ACTIVE",
            "OCCURRENCE_CONFLICT",
            "PREREQUISITE_MISSING",
            "REFERENCE_INVALID",
            "RESERVATION_NOT_FOUND",
            "REPLAY_CONFLICT",
            "REVISION_CONFLICT",
            "ROLE_UNSUPPORTED",
            "SCHEMA_INVALID",
            "STATE_INVALID",
            "TYPE_INVALID",
            "UNSUPPORTED_FEATURE",
            "UNSUPPORTED_RELATION",
            "VERSION_UNSUPPORTED"
          ]
        },
        "path": {
          "const": ""
        }
      },
      "required": [
        "status",
        "code",
        "path"
      ],
      "additionalProperties": false
    },
    "deployInput": {
      "$ref": "https://schemas.seampoint.com/work-class/1.0.0-draft.2/lifecycle.schema.json#/$defs/deployInput"
    },
    "deployResult": {
      "$ref": "https://schemas.seampoint.com/work-class/1.0.0-draft.2/lifecycle.schema.json#/$defs/deployResult"
    },
    "stepInput": {
      "$ref": "https://schemas.seampoint.com/work-class/1.0.0-draft.2/lifecycle.schema.json#/$defs/stepInput"
    },
    "stepResult": {
      "$ref": "https://schemas.seampoint.com/work-class/1.0.0-draft.2/lifecycle.schema.json#/$defs/stepResult"
    },
    "stepRefusal": {
      "$ref": "https://schemas.seampoint.com/work-class/1.0.0-draft.2/lifecycle.schema.json#/$defs/statefulRefusal"
    },
    "hostCommitResult": {
      "$ref": "https://schemas.seampoint.com/work-class/1.0.0-draft.2/lifecycle.schema.json#/$defs/hostCommitResult"
    },
    "evidenceInput": {
      "$ref": "https://schemas.seampoint.com/work-class/1.0.0-draft.2/evidence.schema.json#/$defs/input"
    },
    "evidenceResult": {
      "$ref": "https://schemas.seampoint.com/work-class/1.0.0-draft.2/evidence.schema.json#/$defs/result"
    },
    "evidenceRefusal": {
      "$ref": "https://schemas.seampoint.com/work-class/1.0.0-draft.2/evidence.schema.json#/$defs/refusal"
    },
    "request": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "protocol": {
              "const": "seampoint.work-class.adapter/1.0.0-draft.2"
            },
            "request_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,127}$"
            },
            "operation": {
              "const": "capabilities"
            },
            "input": {
              "$ref": "#/$defs/capabilitiesInput"
            }
          },
          "required": [
            "protocol",
            "request_id",
            "operation",
            "input"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "protocol": {
              "const": "seampoint.work-class.adapter/1.0.0-draft.2"
            },
            "request_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,127}$"
            },
            "operation": {
              "const": "validate"
            },
            "input": {
              "$ref": "#/$defs/artifactInput"
            }
          },
          "required": [
            "protocol",
            "request_id",
            "operation",
            "input"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "protocol": {
              "const": "seampoint.work-class.adapter/1.0.0-draft.2"
            },
            "request_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,127}$"
            },
            "operation": {
              "const": "evaluate"
            },
            "input": {
              "$ref": "#/$defs/evaluateInput"
            }
          },
          "required": [
            "protocol",
            "request_id",
            "operation",
            "input"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "protocol": {
              "const": "seampoint.work-class.adapter/1.0.0-draft.2"
            },
            "request_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,127}$"
            },
            "operation": {
              "const": "aggregate-step"
            },
            "input": {
              "$ref": "https://schemas.seampoint.com/work-class/1.0.0-draft.2/reservation.schema.json#/$defs/input"
            }
          },
          "required": [
            "protocol",
            "request_id",
            "operation",
            "input"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "protocol": {
              "const": "seampoint.work-class.adapter/1.0.0-draft.2"
            },
            "request_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,127}$"
            },
            "operation": {
              "const": "deploy"
            },
            "input": {
              "$ref": "#/$defs/deployInput"
            }
          },
          "required": [
            "protocol",
            "request_id",
            "operation",
            "input"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "protocol": {
              "const": "seampoint.work-class.adapter/1.0.0-draft.2"
            },
            "request_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,127}$"
            },
            "operation": {
              "const": "step"
            },
            "input": {
              "$ref": "#/$defs/stepInput"
            }
          },
          "required": [
            "protocol",
            "request_id",
            "operation",
            "input"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "protocol": {
              "const": "seampoint.work-class.adapter/1.0.0-draft.2"
            },
            "request_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,127}$"
            },
            "operation": {
              "const": "readback"
            },
            "input": {
              "$ref": "#/$defs/artifactInput"
            }
          },
          "required": [
            "protocol",
            "request_id",
            "operation",
            "input"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "protocol": {
              "const": "seampoint.work-class.adapter/1.0.0-draft.2"
            },
            "request_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,127}$"
            },
            "operation": {
              "const": "check-evidence"
            },
            "input": {
              "$ref": "#/$defs/evidenceInput"
            }
          },
          "required": [
            "protocol",
            "request_id",
            "operation",
            "input"
          ],
          "additionalProperties": false
        }
      ]
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "protocol": {
              "const": "seampoint.work-class.adapter/1.0.0-draft.2"
            },
            "request_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,127}$"
            },
            "operation": {
              "const": "capabilities"
            },
            "result": {
              "anyOf": [
                {
                  "$ref": "#/$defs/capabilitiesResult"
                },
                {
                  "$ref": "#/$defs/shapeRefusal"
                }
              ]
            }
          },
          "required": [
            "protocol",
            "request_id",
            "operation",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "protocol": {
              "const": "seampoint.work-class.adapter/1.0.0-draft.2"
            },
            "request_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,127}$"
            },
            "operation": {
              "const": "validate"
            },
            "result": {
              "anyOf": [
                {
                  "$ref": "#/$defs/validateResult"
                },
                {
                  "$ref": "#/$defs/shapeRefusal"
                }
              ]
            }
          },
          "required": [
            "protocol",
            "request_id",
            "operation",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "protocol": {
              "const": "seampoint.work-class.adapter/1.0.0-draft.2"
            },
            "request_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,127}$"
            },
            "operation": {
              "const": "evaluate"
            },
            "result": {
              "anyOf": [
                {
                  "$ref": "https://schemas.seampoint.com/work-class/1.0.0-draft.2/aggregate.schema.json#/$defs/result"
                },
                {
                  "$ref": "https://schemas.seampoint.com/work-class/1.0.0-draft.2/aggregate.schema.json#/$defs/refusal"
                },
                {
                  "$ref": "https://schemas.seampoint.com/work-class/1.0.0-draft.2/authority.schema.json#/$defs/result"
                },
                {
                  "$ref": "https://schemas.seampoint.com/work-class/1.0.0-draft.2/authority.schema.json#/$defs/refusal"
                },
                {
                  "$ref": "#/$defs/shapeRefusal"
                }
              ]
            }
          },
          "required": [
            "protocol",
            "request_id",
            "operation",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "protocol": {
              "const": "seampoint.work-class.adapter/1.0.0-draft.2"
            },
            "request_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,127}$"
            },
            "operation": {
              "const": "aggregate-step"
            },
            "result": {
              "anyOf": [
                {
                  "$ref": "https://schemas.seampoint.com/work-class/1.0.0-draft.2/reservation.schema.json#/$defs/result"
                },
                {
                  "$ref": "https://schemas.seampoint.com/work-class/1.0.0-draft.2/reservation.schema.json#/$defs/statefulRefusal"
                },
                {
                  "$ref": "https://schemas.seampoint.com/work-class/1.0.0-draft.2/reservation.schema.json#/$defs/shapeRefusal"
                },
                {
                  "$ref": "#/$defs/shapeRefusal"
                }
              ]
            }
          },
          "required": [
            "protocol",
            "request_id",
            "operation",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "protocol": {
              "const": "seampoint.work-class.adapter/1.0.0-draft.2"
            },
            "request_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,127}$"
            },
            "operation": {
              "const": "deploy"
            },
            "result": {
              "anyOf": [
                {
                  "$ref": "#/$defs/deployResult"
                },
                {
                  "$ref": "https://schemas.seampoint.com/work-class/1.0.0-draft.2/lifecycle.schema.json#/$defs/deployRefusal"
                },
                {
                  "$ref": "#/$defs/shapeRefusal"
                }
              ]
            }
          },
          "required": [
            "protocol",
            "request_id",
            "operation",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "protocol": {
              "const": "seampoint.work-class.adapter/1.0.0-draft.2"
            },
            "request_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,127}$"
            },
            "operation": {
              "const": "step"
            },
            "result": {
              "anyOf": [
                {
                  "$ref": "#/$defs/stepResult"
                },
                {
                  "$ref": "#/$defs/stepRefusal"
                },
                {
                  "$ref": "#/$defs/shapeRefusal"
                }
              ]
            }
          },
          "required": [
            "protocol",
            "request_id",
            "operation",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "protocol": {
              "const": "seampoint.work-class.adapter/1.0.0-draft.2"
            },
            "request_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,127}$"
            },
            "operation": {
              "const": "readback"
            },
            "result": {
              "anyOf": [
                {
                  "$ref": "#/$defs/readbackResult"
                },
                {
                  "$ref": "#/$defs/shapeRefusal"
                }
              ]
            }
          },
          "required": [
            "protocol",
            "request_id",
            "operation",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "protocol": {
              "const": "seampoint.work-class.adapter/1.0.0-draft.2"
            },
            "request_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,127}$"
            },
            "operation": {
              "const": "check-evidence"
            },
            "result": {
              "anyOf": [
                {
                  "$ref": "#/$defs/evidenceResult"
                },
                {
                  "$ref": "#/$defs/evidenceRefusal"
                },
                {
                  "$ref": "#/$defs/shapeRefusal"
                }
              ]
            }
          },
          "required": [
            "protocol",
            "request_id",
            "operation",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "protocol": {
              "const": "seampoint.work-class.adapter/1.0.0-draft.2"
            },
            "request_id": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,127}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "operation": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,127}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "result": {
              "type": "object",
              "properties": {
                "status": {
                  "const": "REFUSED"
                },
                "code": {
                  "const": "PROTOCOL_INVALID"
                },
                "path": {
                  "const": ""
                }
              },
              "required": [
                "status",
                "code",
                "path"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "protocol",
            "request_id",
            "operation",
            "result"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ]
}
