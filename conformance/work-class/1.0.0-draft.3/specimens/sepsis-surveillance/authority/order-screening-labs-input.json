["patient_id"]}},{"exclusive_keys":[],"executor_role":"surveillance-agent","fields":[{"name":"alert_id","type_ref":"t.identity"},{"name":"patient_id","type_ref":"t.identity"},{"name":"risk_score","type_ref":"t.score"}],"id":"raise-alert","interface":"nurse-notification","operation":"raise-sepsis-alert","quantity_mode":"BOUNDED","required_credentials":["surveillance-agent-credential"],"scope_fields":{"resources":["alert_id"],"subjects":["patient_id"]}},{"exclusive_keys":[],"executor_role":"surveillance-agent","fields":[{"name":"attempt_number","type_ref":"t.count"},{"name":"patient_id","type_ref":"t.identity"},{"name":"refresh_id","type_ref":"t.identity"}],"id":"refresh-vitals","interface":"monitoring-feed","operation":"request-vitals-refresh","quantity_mode":"BOUNDED","required_credentials":["surveillance-agent-credential"],"scope_fields":{"resources":["refresh_id"],"subjects":["patient_id"]}}],"types":[{"id":"t.boolean","kind":"BOOLEAN","nonnegative":false,"unit":null},{"id":"t.count","kind":"INTEGER","nonnegative":true,"unit":null},{"id":"t.dose","kind":"DECIMAL","nonnegative":true,"unit":"mg"},{"id":"t.identity","kind":"IDENTITY","nonnegative":false,"unit":null},{"id":"t.score","kind":"DECIMAL","nonnegative":true,"unit":null},{"id":"t.seconds","kind":"INTEGER","nonnegative":true,"unit":null},{"id":"t.text","kind":"STRING","nonnegative":false,"unit":null}]}}
