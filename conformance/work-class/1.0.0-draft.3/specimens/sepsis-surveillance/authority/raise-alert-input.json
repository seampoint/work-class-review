"principal":"sample-hospital","provider":"hospital-identity-provider","role":"medical-director","validity":{"valid_from":"2026-09-01T00:00:00Z","valid_until":"2026-12-01T00:00:00Z"}},{"actor":"person-quality-officer","evidence_ref":"occupancy-quality-officer-evidence","id":"occupancy-quality-officer","kind":"HUMAN","principal":"sample-hospital","provider":"hospital-identity-provider","role":"clinical-governance-attester","validity":{"valid_from":"2026-09-01T00:00:00Z","valid_until":"2026-12-01T00:00:00Z"}},{"actor":"sepsis-surveillance-agent","evidence_ref":"occupancy-surveillance-agent-evidence","id":"occupancy-surveillance-agent","kind":"MACHINE","principal":"sample-hospital","provider":"hospital-identity-provider","role":"surveillance-agent","validity":{"valid_from":"2026-09-01T00:00:00Z","valid_until":"2026-12-01T00:00:00Z"}}],"proposal":{"executor":{"actor":"sepsis-surveillance-agent","occupancy":"occupancy-surveillance-agent","principal":"sample-hospital","role":"surveillance-agent"},"fields":[{"name":"alert_id","value":{"type_ref":"t.identity","value":"alert-4471"}},{"name":"patient_id","value":{"type_ref":"t.identity","value":"patient-1"}},{"name":"risk_score","value":{"type_ref":"t.score","value":"0.82"}}],"instance":"sepsis-instance-1","interface":"nurse-notification","occurrence":"sha256:aa6200adeab992077bde10c2156741208ca8b542bcbd65bf542c1c13b90ad926","operation":"raise-sepsis-alert","schema":"seampoint.work-class/1.0.0-draft.3/authority-proposal","step":"raise-alert","work_class":"sepsis-surveillance-bundle","work_class_digest":"sha256:b0898bb6db55f1fd4d6ca28ad0cae63a4636070f9402f09f7f3ec4d8cdd1444d"},"returns":[{"act_bytes_base64":"","act_digest":"sha256:8e917b575360a624d2a2b60f796e68ab5e5893c4cfdfd5d1b1c83f8652689832","actor":"person-quality-officer","channel":"authority-return-channel","evidence_ref":"return-attest-grant-alert-authority-evidence","id":"return-attest-grant-alert-authority","provider":"hospital-identity-provider","returned_at":"2026-09-01T09:01:00Z"},{"act_bytes_base64":"","act_digest":"sha256:5b2f7061fc32d24d9a6f8db4c64e1bef59a8b1edafe2afb3f6814c1e87902d99","actor":"person-medical-director","channel":"authority-return-channel","evidence_ref":"return-grant-alert-authority-evidence","id":"return-grant-alert-authority","provider":"hospital-identity-provider","returned_at":"2026-09-01T09:00:00Z"}],"schema":"seampoint.work-class/1.0.0-draft.3/authority-input","source":{"id":"sepsis-surveillance-policy","obligations":[{"id":"alert-window-cap","text":"A patient receives at most two sepsis alerts in any rolling six-hour window; a further alert inside the window is refused by the alert-count aggregate and recorded as suppressed before any instance is deployed."},{"id":"antibiotic-requires-physician-order","text":"An antibiotic order requires the attending physician's per-instance order naming the patient, drug, dose and route, verified by pharmacy; the surveillance agent's proposal is a candidate and the physician's order is the act."},{"id":"bundle-completion-is-reconciled","text":"The bundle completes only on native records: the laboratory result record and the medication administration record. An order with no administration record is an unknown outcome that neither completes nor releases the obligation, and a result that arrives after its deadline counts as evidence for what it shows without making the missed deadline met."},{"id":"cultures-before-antibiotics-unless-overridden","text":"Blood cultures are drawn before antibiotics are administered unless drawing them would delay antibiotics more than forty-five minutes, in which case the attending may authorize administration first and the reason is recorded with the order."},{"id":"escalate-unacknowledged-page","text":"The attending is paged on alert; if no acknowledgement is recorded within fifteen minutes of the page, the agent escalates to the rapid-response team and the bundle continues."},{"id":"hour-one-bundle","text":"Time zero is the alert's recorded recognition time. Screening labs are resulted and antibiotics administered, each with native evidence, within one hour of time zero."},{"id":"screening-under-standing-protocol","text":"A registered nurse may order the sepsis screening set (lactate, blood cultures, complete blood count) under the standing protocol without a physician order; the grant is limited to the named tests, bound to the protocol version, and withdrawn when the version is retired."},{"id":"vitals-freshness","text":"Vitals older than fifteen minutes are indeterminate for any decision that depends on them; an indeterminate observation holds the dependent action and a fresh observation re-evaluates it."}],"revision":"v3","schema":"seampoint.work-class/1.0.0-draft.3/authority-source"},"specification_pin":"sha256:fd52d69dd3c3546bff2cec9d46fb8d6b942fd57b77b0a3ab8377a592e80d00b6","work_class":{"id":"sepsis-surveillance-bundle","revision":"r1","schema":"seampoint.work-class/1.0.0-draft.3/authority-work-class","steps":[{"exclusive_keys":[],"executor_role":"surveillance-agent","fields":[{"name":"assessment_id","type_ref":"t.identity"},{"name":"lookback_seconds","type_ref":"t.seconds"},{"name":"patient_id","type_ref":"t.identity"}],"id":"assess-readiness","interface":"monitoring-feed","operation":"assess-antibiotic-readiness","quantity_mode":"BOUNDED","required_credentials":["surveillance-agent-credential"],"scope_fields":{"resources":["assessment_id"],"subjects":["patient_id"]}},{"exclusive_keys":[],"executor_role":"surveillance-agent","fields":[{"name":"attempt_number","type_ref":"t.count"},{"name":"page_id","type_ref":"t.identity"},{"name":"patient_id","type_ref":"t.identity"}],"id":"escalate-rapid-response","interface":"paging-system","operation":"page-rapid-response","quantity_mode":"BOUNDED","required_credentials":["surveillance-agent-credential"],"scope_fields":{"resources":["page_id"],"subjects":["patient_id"]}},{"exclusive_keys":[],"executor_role":"attending-physician","fields":[{"name":"