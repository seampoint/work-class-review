nous"}},{"name":"vitals_age_seconds","value":{"type_ref":"t.seconds","value":"120"}}],"instance":"sepsis-instance-1","interface":"order-entry","occurrence":"sha256:c6e89a66861fdb10a81f12e65a36e6eaea00b306563ab831715bee10913193ae","operation":"place-antibiotic-order","schema":"seampoint.work-class/1.0.0-draft.3/authority-proposal","step":"order-antibiotic","work_class":"sepsis-surveillance-bundle","work_class_digest":"sha256:b0898bb6db55f1fd4d6ca28ad0cae63a4636070f9402f09f7f3ec4d8cdd1444d"},"returns":[{"act_bytes_base64":"","act_digest":"sha256:c2b49b9c1de5fed712a19719f0093bc93e83e4dc7e720d0a5c5dbaa0968c1bfd","actor":"pharmacist-1","channel":"authority-return-channel","evidence_ref":"return-attest-grant-antibiotic-order-authority-evidence","id":"return-attest-grant-antibiotic-order-authority","provider":"hospital-identity-provider","returned_at":"2026-09-01T09:01:00Z"},{"act_bytes_base64":"","act_digest":"sha256:bfa736546e7ee71275f7ff9b82dbabcae659ca63429e27f898b4af4bea338eb6","actor":"person-medical-director","channel":"authority-return-channel","evidence_ref":"return-grant-antibiotic-order-authority-evidence","id":"return-grant-antibiotic-order-authority","provider":"hospital-identity-provider","returned_at":"2026-09-01T09:00:00Z"},{"act_bytes_base64":"","act_digest":"sha256:680b58be8be702a0593dbf254d98e33635da56de26bb300c79d4b51d4c12dd39","actor":"attending-hospitalist-1","channel":"authority-return-channel","evidence_ref":"return-order-decision-c6e89a66861f-0834-a-evidence","id":"return-order-decision-c6e89a66861f-0834-a","provider":"hospital-identity-provider","returned_at":"2026-09-12T08:34:00Z"},{"act_bytes_base64":"","act_digest":"sha256:f576c09bc7a6bacf47f34e9f7e978ec582f78c6f055d528e97dd288f28591764","actor":"pharmacist-1","channel":"authority-return-channel","evidence_ref":"return-verify-order-decision-c6e89a66861f-0834-a-evidence","id":"return-verify-order-decision-c6e89a66861f-0834-a","provider":"hospital-identity-provider","returned_at":"2026-09-12T08:35:00Z"}],"schema":"seampoint.work-class/1.0.0-draft.3/authority-input","source":{"id":"sepsis-surveillance-policy","obligations":[{"id":"alert-window-cap","text":"A patient receives at most two sepsis alerts in any rolling six-hour window; a further alert inside the window is refused by the alert-count aggregate and recorded as suppressed before any instance is deployed."},{"id":"antibiotic-requires-physician-order","text":"An antibiotic order requires the attending physician's per-instance order naming the patient, drug, dose and route, verified by pharmacy; the surveillance agent's proposal is a candidate and the physician's order is the act."},{"id":"bundle-completion-is-reconciled","text":"The bundle completes only on native records: the laboratory result record and the medication administration record. An order with no administration record is an unknown outcome that neither completes nor releases the obligation, and a result that arrives after its deadline counts as evidence for what it shows without making the missed deadline met."},{"id":"cultures-before-antibiotics-unless-overridden","text":"Blood cultures are drawn before antibiotics are administered unless drawing them would delay antibiotics more than forty-five minutes, in which case the attending may authorize administration first and the reason is recorded with the order."},{"id":"escalate-unacknowledged-page","text":"The attending is paged on alert; if no acknowledgement is recorded within fifteen minutes of the page, the agent escalates to the rapid-response team and the bundle continues."},{"id":"hour-one-bundle","text":"Time zero is the alert's recorded recognition time. Screening labs are resulted and antibiotics administered, each with native evidence, within one hour of time zero."},{"id":"screening-under-standing-protocol","text":"A registered nurse may order the sepsis screening set (lactate, blood cultures, complete blood count) under the standing protocol without a physician order; the grant is limited to the named tests, bound to the protocol version, and withdrawn when the version is retired."},{"id":"vitals-freshness","text":"Vitals older than fifteen minutes are indeterminate for any decision that depends on them; an indeterminate observation holds the dependent action and a fresh observation re-evaluates it."}],"revision":"v3","schema":"seampoint.work-class/1.0.0-draft.3/authority-source"},"specification_pin":"sha256:fd52d69dd3c3546bff2cec9d46fb8d6b942fd57b77b0a3ab8377a592e80d00b6","work_class":{"id":"sepsis-surveillance-bundle","revision":"r1","schema":"seampoint.work-class/1.0.0-draft.3/authority-work-class","steps":[{"exclusive_keys":[],"executor_role":"surveillance-agent","fields":[{"name":"assessment_id","type_ref":"t.identity"},{"name":"lookback_seconds","type_ref":"t.seconds"},{"name":"patient_id","type_ref":"t.identity"}],"id":"assess-readiness","interface":"monitoring-feed","operation":"assess-antibiotic-readiness","quantity_mode":"BOUNDED","required_credentials":["surveillance-agent-credential"],"scope_fields":{"resources":["assessment_id"],"subjects":["patient_id"]}},{"exclusive_keys":[],"executor_role":"surveillance-agent","fields":[{"name":"attempt_number","type_ref":"t.count"},{"name":"page_id","type_ref":"t.identity"},{"name":"patient_id","type_ref":"t.identity"}],"id":"escalate-rapid-response","interface":"paging-system","operation":"page-rapid-response","quantity_mode":"BOUNDED","required_credentials":["surveillance-agent-credential"],"scope_fields":{"resources":["page_id"],"subjects":["patient_id"]}},{"exclusive_keys":[],"executor_role":"attending-physician","fields":[{"name":"cultures_drawn_first","type_ref":"t.boolean"},{"name":"dose_mg","type_ref":"t.dose"},{"name":"drug","type_ref":"t.text"},{"name":"order_id","type_ref":"t.identity"},{"name":"override_reason","type_ref":"t.text"},{"name":"patient_id","type_ref":"t.identity"},{"name":"route","type_ref":"t.text"},{"name":"vitals_age_seconds","type_ref":"t.seconds"}],"id":"order-antibiotic","interface":"order-entry","operation":"place-antibiotic-order","quantity_mode":"BOUNDED","required_credentials":["physician-licence"],"scope_fields":{"resources":["order_id"],"subjects":["patient_id"]}},{"exclusive_keys":[],"executor_role":"registered-nurse","fields":[{"name":"order_set_id","type_ref":"t.identity"},{"name":"panel","type_ref":"t.text"},{"name":"patient_id","type_ref":"t.identity"},{"name":"test_count","type_ref":"t.count"}],"id":"order-screening-labs","interface":"order-entry","operation":"order-screening-set","quantity_mode":"BOUNDED","required_credentials":["registered-nurse-licence"],"scope_fields":{"resources":["order_set_id"],"subjects":["patient_id"]}},{"exclusive_keys":[],"executor_role":"surveillance-agent","fields":[{"name":"attempt_number","type_ref":"t.count"},{"name":"page_id","type_ref":"t.identity"},{"name":"patient_id","type_ref":"t.identity"}],"id":"page-attending","interface":"paging-system","operation":"page-attending-physician","quantity_mode":"BOUNDED","required_credentials":["surveillance-agent-credential"],"scope_fields":{"resources":["page_id"],"subjects":["patient_id"]}},{"exclusive_keys":[],"executor_role":"surveillance-agent","fields":[{"name":"alert_id","type_ref":"t.identity"},{"name":"patient_id","type_ref":"t.identity"},{"name":"risk_score","type_ref":"t.score"}],"id":"raise-alert","interface":"nurse-notification","operation":"raise-sepsis-alert","quantity_mode":"BOUNDED","required_credentials":["surveillance-agent-credential"],"scope_fields":{"resources":["alert_id"],"subjects":["patient_id"]}},{"exclusive_keys":[],"executor_role":"surveillance-agent","fields":[{"name":"attempt_number","type_ref":"t.count"},{"name":"patient_id","type_ref":"t.identity"},{"name":"refresh_id","type_ref":"t.identity"}],"id":"refresh-vitals","interface":"monitoring-feed","operation":"request-vitals-refresh","quantity_mode":"BOUNDED","required_credentials":["surveillance-agent-credential"],"scope_fields":{"resources":["refresh_id"],"subjects":["patient_id"]}}],"types":[{"id":"t.boolean","kind":"BOOLEAN","nonnegative":false,"unit":null},{"id":"t.count","kind":"INTEGER","nonnegative":true,"unit":null},{"id":"t.dose","kind":"DECIMAL","nonnegative":true,"unit":"mg"},{"id":"t.identity","kind":"IDENTITY","nonnegative":false,"unit":null},{"id":"t.score","kind":"DECIMAL","nonnegative":true,"unit":null},{"id":"t.seconds","kind":"INTEGER","nonnegative":true,"unit":null},{"id":"t.text","kind":"STRING","nonnegative":false,"unit":null}]}}
