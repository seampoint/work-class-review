"person-medical-director","evidence_ref":"occupancy-medical-director-evidence","id":"occupancy-medical-director","kind":"HUMAN","principal":"sample-hospital","provider":"hospital-identity-provider","role":"medical-director","validity":{"valid_from":"2026-09-01T00:00:00Z","valid_until":"2026-12-01T00:00:00Z"}},{"actor":"person-quality-officer","evidence_ref":"occupancy-quality-officer-evidence","id":"occupancy-quality-officer","kind":"HUMAN","principal":"sample-hospital","provider":"hospital-identity-provider","role":"clinical-governance-attester","validity":{"valid_from":"2026-09-01T00:00:00Z","valid_until":"2026-12-01T00:00:00Z"}},{"actor":"sepsis-surveillance-agent","evidence_ref":"occupancy-surveillance-agent-evidence","id":"occupancy-surveillance-agent","kind":"MACHINE","principal":"sample-hospital","provider":"hospital-identity-provider","role":"surveillance-agent","validity":{"valid_from":"2026-09-01T00:00:00Z","valid_until":"2026-12-01T00:00:00Z"}}],"proposal":{"executor":{"actor":"sepsis-surveillance-agent","occupancy":"occupancy-surveillance-agent","principal":"sample-hospital","role":"surveillance-agent"},"fields":[{"name":"attempt_number","value":{"type_ref":"t.count","value":"1"}},{"name":"page_id","value":{"type_ref":"t.identity","value":"page-3301"}},{"name":"patient_id","value":{"type_ref":"t.identity","value":"patient-1"}}],"instance":"sepsis-timing-instance-1","interface":"paging-system","occurrence":"sha256:ba406027581a028f09711f46c02674a5c0821456f908048b36082196ca56d283","operation":"page-attending-physician","schema":"seampoint.work-class/1.0.0-draft.3/authority-proposal","step":"page-attending","work_class":"sepsis-surveillance-timing-bundle","work_class_digest":"sha256:cf6d2026979c2f0e8122be34f5dc7884fb40397b6fbe12cdca8012211e8f0357"},"returns":[{"act_bytes_base64":"","act_digest":"sha256:dbedd8d6c8d5ae2b97478ca54d1e6c8ca5fda9439fcf5d2a1d512932c2a98215","actor":"person-quality-officer","channel":"authority-return-channel","evidence_ref":"return-attest-grant-page-authority-evidence","id":"return-attest-grant-page-authority","provider":"hospital-identity-provider","returned_at":"2026-09-01T09:01:00Z"},{"act_bytes_base64":"","act_digest":"sha256:016bc4273253612248aa5c3ed7979a3526f43f0fa9ef1b2af8ce10711d2c2299","actor":"person-medical-director","channel":"authority-return-channel","evidence_ref":"return-grant-page-authority-evidence","id":"return-grant-page-authority","provider":"hospital-identity-provider","returned_at":"2026-09-01T09:00:00Z"}],"schema":"seampoint.work-class/1.0.0-draft.3/authority-input","source":{"id":"sepsis-surveillance-policy","obligations":[{"id":"alert-window-cap","text":"A patient receives at most two sepsis alerts in any rolling six-hour window; a further alert inside the window is refused by the alert-count aggregate and recorded as suppressed before any instance is deployed."},{"id":"antibiotic-requires-physician-order","text":"An antibiotic order requires the attending physician's per-instance order naming the patient, drug, dose and route, verified by pharmacy; the surveillance agent's proposal is a candidate and the physician's order is the act."},{"id":"bundle-completion-is-reconciled","text":"The bundle completes only on native records: the laboratory result record and the medication administration record. An order with no administration record is an unknown outcome that neither completes nor releases the obligation, and a result that arrives after its deadline counts as evidence for what it shows without making the missed deadline met."},{"id":"cultures-before-antibiotics-unless-overridden","text":"Blood cultures are drawn before antibiotics are administered unless drawing them would delay antibiotics more than forty-five minutes, in which case the attending may authorize administration first and the reason is recorded with the order."},{"id":"escalate-unacknowledged-page","text":"The attending is paged on alert; if no acknowledgement is recorded within fifteen minutes of the page, the agent escalates to the rapid-response team and the bundle continues."},{"id":"hour-one-bundle","text":"Time zero is the alert's recorded recognition time. Screening labs are resulted and antibiotics administered, each with native evidence, within one hour of time zero."},{"id":"screening-under-standing-protocol","text":"A registered nurse may order the sepsis screening set (lactate, blood cultures, complete blood count) under the standing protocol without a physician order; the grant is limited to the named tests, bound to the protocol version, and withdrawn when the version is retired."},{"id":"vitals-freshness","text":"Vitals older than fifteen minutes are indeterminate for any decision that depends on them; an indeterminate observation holds the dependent action and a fresh observation re-evaluates it."}],"revision":"v4","schema":"seampoint.work-class/1.0.0-draft.3/authority-source"},"specification_pin":"sha256:fd52d69dd3c3546bff2cec9d46fb8d6b942fd57b77b0a3ab8377a592e80d00b6","work_class":{"id":"sepsis-surveillance-timing-bundle","revision":"r1","schema":"seampoint.work-class/1.0.0-draft.3/authority-work-class","steps":[{"authority_type_refs":["t.instant"],"exclusive_keys":[],"executor_role":"surveillance-agent","fields":[{"name":"assessment_id","type_ref":"t.identity"},{"name":"lookback_seconds","type_ref":"t.seconds"},{"name":"patient_id","type_ref":"t.identity"}],"id":"assess-readiness","interface":"monitoring-feed","operation":"assess-antibiotic-readiness","quantity_mode":"BOUNDED","required_credentials":["surveillance-agent-credential"],"scope_fields":{"resources":["assessment_id"],"subjects":["patient_id"]}},{"exclusive_keys":[],"executor_role":"surveillance-agent","fields":[{"name":"attempt_number","type_ref":"t.count"},{"name":"page_id","type_ref":"t.identity"},{"name":"patient_id","type_ref":"t.identity"}],"id":"escalate-rapid-response","interface":"paging-system","operation":"page-rapid-response","quantity_mode":"BOUNDED","required_credentia